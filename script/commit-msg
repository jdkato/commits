#!/bin/sh
#
# A commit-msg hook. Git passes the path of the message file, and Vale reads
# it on stdin; --path names the section that applies, since the text has no
# name of its own. An error-level alert exits non-zero, and the commit stops
# with the alerts on screen.
#
# Messages Git writes itself are left alone, as commitlint leaves them:
# merges, reverts, and the fixup!/squash!/amend! prefixes autosquash reads.
#
# On a fresh clone the styles are not there yet, and `vale sync` fetches
# them; the hook does that once, when the StylesPath the config names has
# no Commits directory, so the first commit after a clone needs the network
# and every one after it does not.
#
# Install it with either of:
#
#   cp script/commit-msg .git/hooks/commit-msg
#   git config core.hooksPath script
case "$(sed -n '1p' "$1")" in
"Merge "* | "Revert "* | "Reapply "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

styles=$(sed -n 's/^StylesPath *= *//p' .vale.ini 2>/dev/null)
if [ -n "$styles" ] && [ ! -d "$styles/Commits" ]; then
	vale sync || exit 2
fi

exec vale --path=COMMIT_EDITMSG < "$1"
